{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phantom",
  "version": "0.1.0",
  "identifier": "com.phantom.ep-autoanswer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Phantom",
        "width": 420,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCM0NDMTY0NDcwQjJFRUEKUldUcUxndEhaTUU4dXhWY0dZUkU1Z1FKT0xrMkEyU01UK3VMSWVudVFxNy81b1BwUG11L3M4VWoK",
      "endpoints": ["https://phantommacro.app/update/latest.json"]
    }
  }
}
